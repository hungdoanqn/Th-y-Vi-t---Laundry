{
  "functions": { "api/rpc.js": { "maxDuration": 30, "includeFiles": "lib/**" } },
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Content-Type-Options", "value": "nosniff" } ] },
    { "source": "/(app.js|screens/(.*)|lib/(.*))", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
